# Пример переменных окружения. Настоящие значения хранятся только в настройках
# сервисов (Cloudflare, GitHub Secrets) и локально в .env, который не коммитится.
# Не вписывай сюда реальные токены.

# Токен Telegram-бота (только в секретах Cloudflare Worker)
TELEGRAM_BOT_TOKEN=

# Токен GitHub с доступом только к репозиторию hub-data (минимальные права)
GITHUB_DATA_TOKEN=
